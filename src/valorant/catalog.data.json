  "agents": [
    {
      "id": "brimstone",
      "name": "Brimstone",
      "nameZh": "布史东",
      "role": "controller",
      "color": "#c8724a",
      "lines": {
        "praise": "干得不错，再来一遍",
        "taunt": "站住位置，你这枪法像洒水",
        "start": "来，先把桌子摆好",
        "finish": "赢下来，撤退我掩护"
      },
      "linesEn": {
        "praise": "Good work. Now do it again.",
        "taunt": "Hold your ground. You're spraying worse than a rookie.",
        "start": "Let's set the table.",
        "finish": "Take the win. I'll cover the retreat."
      },
      "voice": "Rocko"
    },
    {
      "id": "viper",
      "name": "Viper",
      "nameZh": "薇蝮",
      "role": "controller",
      "color": "#3fbf8f",
      "lines": {
        "praise": "效率不错，几乎算冷静",
        "taunt": "你的准星，一股毒味",
        "start": "呼吸别太深，会死",
        "finish": "清干净了，回家吧"
      },
      "linesEn": {
        "praise": "Efficient. Almost clinical.",
        "taunt": "Your aim is a toxin I can smell.",
        "start": "Don't breathe too deep.",
        "finish": "Cleared. Go home."
      },
      "voice": "Shelley"
    },
    {
      "id": "omen",
      "name": "Omen",
      "nameZh": "欧门",
      "role": "controller",
      "color": "#6b5bd1",
      "lines": {
        "praise": "有意思，你还记得怎么打中",
        "taunt": "你在黑暗里摸索，我就住那儿",
        "start": "醒过来，再来一次",
        "finish": "噩梦，到此为止了"
      },
      "linesEn": {
        "praise": "Interesting. You remember how to hit.",
        "taunt": "You stumble in the dark. I live there.",
        "start": "Wake up. Again.",
        "finish": "The nightmare ends here."
      },
      "voice": "Reed"
    },
    {
      "id": "killjoy",
      "name": "Killjoy",
      "nameZh": "奇乐",
      "role": "sentinel",
      "color": "#f2c14e",
      "lines": {
        "praise": "不错嘛，我的炮台都要嫉妒",
        "taunt": "卡住了？我给你造个计算器",
        "start": "来，把诊断跑一遍",
        "finish": "系统全绿，基本上吧"
      },
      "linesEn": {
        "praise": "Nice! My turret would be jealous.",
        "taunt": "Stuck? I can build you a calculator.",
        "start": "Let's run the diagnostics.",
        "finish": "All systems green. Mostly."
      },
      "voice": "Sandy"
    },
    {
      "id": "cypher",
      "name": "Cypher",
      "nameZh": "零",
      "role": "sentinel",
      "color": "#d9b382",
      "lines": {
        "praise": "精准，我喜欢这种手感",
        "taunt": "你这一枪怎么偏，我早知道",
        "start": "情报，才是胜负手",
        "finish": "案子结了，线都收回来"
      },
      "linesEn": {
        "praise": "Precise. I like that.",
        "taunt": "I already know how you'll miss.",
        "start": "Information wins wars.",
        "finish": "Case closed."
      },
      "voice": "Eddy"
    },
    {
      "id": "sova",
      "name": "Sova",
      "nameZh": "苏法",
      "role": "initiator",
      "color": "#7fb3d5",
      "lines": {
        "praise": "枪很干净，每一发我都看见",
        "taunt": "他们会在雪地里找到你",
        "start": "手要稳，眼睛要准",
        "finish": "这场狩猎到此结束"
      },
      "linesEn": {
        "praise": "Clean shots. I saw every one.",
        "taunt": "They'll find you in the snow.",
        "start": "Steady hand, sharp eye.",
        "finish": "The hunt is over."
      },
      "voice": "Rocko"
    },
    {
      "id": "sage",
      "name": "Sage",
      "nameZh": "贤者",
      "role": "sentinel",
      "color": "#7fe0c3",
      "lines": {
        "praise": "心很稳，你在进步",
        "taunt": "呼吸，慌才是你的敌人",
        "start": "先定住自己，再出手",
        "finish": "歇会儿吧，你值得"
      },
      "linesEn": {
        "praise": "Calm. You're improving.",
        "taunt": "Breathe. Panic is the enemy.",
        "start": "Center yourself.",
        "finish": "Rest. You earned it."
      },
      "voice": "Tingting"
    },
    {
      "id": "phoenix",
      "name": "Phoenix",
      "nameZh": "不死鸟",
      "role": "duelist",
      "color": "#ff7a3d",
      "lines": {
        "praise": "这才叫手感，看到没",
        "taunt": "来啊兄弟，你这是在玩火",
        "start": "点火，给我烧起来",
        "finish": "完美收官，下一回合"
      },
      "linesEn": {
        "praise": "That's what I'm talking about!",
        "taunt": "Come on, mate, you're playing with fire.",
        "start": "Let's light it up.",
        "finish": "Flawless. Next round."
      },
      "voice": "Eddy"
    },
    {
      "id": "jett",
      "name": "Jett",
      "nameZh": "捷特",
      "role": "duelist",
      "color": "#8fd3ff",
      "lines": {
        "praise": "不错，跟得上我的节奏",
        "taunt": "你在犹豫，犹豫就会输",
        "start": "动起来，动作快点",
        "finish": "干净利落，别慢下来"
      },
      "linesEn": {
        "praise": "Nice. Keep up with me.",
        "taunt": "You're hesitating. That's how you lose.",
        "start": "Let's move. Fast.",
        "finish": "Clean. Don't get slow now."
      },
      "voice": "Flo"
    },
    {
      "id": "reyna",
      "name": "Reyna",
      "nameZh": "蕾娜",
      "role": "duelist",
      "color": "#b45bd6",
      "lines": {
        "praise": "好味道，再来一口",
        "taunt": "你是装成猎手的猎物",
        "start": "喂我，我还没吃饱",
        "finish": "他们什么都不是，你可以更强"
      },
      "linesEn": {
        "praise": "Delicious. More.",
        "taunt": "You're prey pretending to be a predator.",
        "start": "Feed me.",
        "finish": "They were nothing. You could be more."
      },
      "voice": "Shelley"
    },
    {
      "id": "raze",
      "name": "Raze",
      "nameZh": "蕾兹",
      "role": "duelist",
      "color": "#ffb347",
      "lines": {
        "praise": "炸得漂亮，就是这个味",
        "taunt": "哈！我的手雷都瞄得比你准",
        "start": "来，炸点东西玩玩",
        "finish": "炸完收工，这章过了"
      },
      "linesEn": {
        "praise": "Boom! Beautiful!",
        "taunt": "Ha! Even my grenade aims better.",
        "start": "Let's blow something up.",
        "finish": "Boom goes the chapter."
      },
      "voice": "Sandy"
    },
    {
      "id": "breach",
